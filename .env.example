# Copy to .env and fill in before `docker compose up -d`.
# Never commit the real .env — it's already in .gitignore.

# ---- Domain (must have a DNS A record pointing at this VM's IP already) ----
# Single domain, path-based routing (see deploy/Caddyfile) -- the backend
# is reached through the same host at /api/*, /auth/*, /health, /ws/*.
APP_DOMAIN=yourdomain.com
PUBLIC_API_URL=https://yourdomain.com
PUBLIC_WS_URL=wss://yourdomain.com/ws/signals

# ---- Auth ----
# Generate BOTH with:
#   docker compose run --rm backend python -m app.scripts.gen_secrets --admin
# (or `openssl rand -hex 32` for just the JWT secret). The backend refuses to
# start in production if the secret is missing or still the dev default.
GLASSBOX_JWT_SECRET=
# Admin login = username "admin" + this password. There is NO built-in
# default admin any more. Prefer the bcrypt hash (keep the single quotes --
# the hash contains $ characters); a plain password of 12+ chars also works.
# Leave both blank and there is simply no admin account.
GLASSBOX_ADMIN_PASSWORD_HASH=
GLASSBOX_ADMIN_PASSWORD=

# ---- Google sign-in (optional; unset = the button stays honestly
# disabled, see backend/app/oauth_google.py). From Google Cloud Console
# -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Authorized redirect URI: https://<APP_DOMAIN>/auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---- Database (optional; unset = local SQLite file, see backend/app/db.py) ----
# Set to a Postgres connection string (e.g. from Neon's dashboard --
# "Connection Details" -> the pooled or direct connection string) to run
# against that instead. Use the postgresql+psycopg:// scheme so SQLAlchemy
# picks the psycopg driver already in requirements.txt. sslmode=require is
# added automatically if not already present.
DATABASE_URL=

# ---- Live trading data ----
# Not an env var — place your synced TradingStorage data (data_parquet/,
# training_results/, etc.) in ./trading-storage next to this compose file.
# It's bind-mounted read-only into the backend at a fixed path. Leave the
# directory empty/absent and data_source.py falls back to reports/ instead.

# ---- LLM providers (all optional; unset = provider reports "not configured"
# in /api/admin/providers/health rather than failing) ----
VLLM_BASE_URL=
GEMINI_API_KEY=
GEMINI_INPUT_COST_PER_1M=
GEMINI_OUTPUT_COST_PER_1M=
ANTHROPIC_API_KEY=

# ---- Strategy Lenses text-to-speech (both optional; unset = /api/tts
# returns a clean 503 -- see backend/app/tts.py) ----
HUGGINGFACE_API_KEY=
ELEVENLABS_API_KEY=
# ElevenLabs is skipped for the rest of the UTC day once this many characters
# are spent (Kokoro / the browser voice take over). Cached lines cost nothing.
TTS_DAILY_CHAR_BUDGET=30000
RATE_LIMIT_TTS_PER_MIN=10
RATE_LIMIT_TTS_PER_DAY=150

# OLLAMA_BASE_URL defaults to the bundled `ollama` compose service
# (started with: docker compose --profile local-llm up -d).
# Point it elsewhere instead if you're running Ollama on a separate GPU VM.
OLLAMA_BASE_URL=http://ollama:11434

# ---- Rate limits ----
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_ADMIN_PER_MIN=60
RATE_LIMIT_SIGNUP_PER_MIN=5
RATE_LIMIT_USER_REPORTS_PER_HOUR=6
BACKEND_WORKERS=2

# ---- Paper trading (all optional; see docs/PROJECT_STATUS.md "Phase 1") ----
# 1 = add a short AI-written note to each daily report (best-effort; uses Gemini
# quota). Off by default -- the factual report never needs an LLM.
PAPER_LLM_NARRATIVES=
PAPER_BACKTEST_START=2021-01-04
PAPER_COMMISSION_BPS=5

# ---- LLM failover (all optional; see docs/FREE_LLM_ROUTING.md) ----
# When Gemini's free tier is spent, requests move to the next provider that has a
# key. A provider with no key is skipped -- add a key to switch one on.
OPENROUTER_API_KEY=       # free models + the openrouter/free auto-router: https://openrouter.ai/keys
GROQ_API_KEY=             # https://console.groq.com/keys  (Groq, not xAI's Grok)
CEREBRAS_API_KEY=         # https://cloud.cerebras.ai
GITHUB_MODELS_TOKEN=      # https://github.com/marketplace/models
DASHSCOPE_API_KEY=        # Qwen via Alibaba DashScope (international)
DEEPSEEK_API_KEY=         # paid, very cheap
XAI_API_KEY=              # xAI Grok, paid
# Any OpenAI-compatible gateway you run (OmniRoute, LiteLLM proxy, vLLM ...):
LLM_GATEWAY_BASE_URL=
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_MODELS=
# Order after the requested provider; 0 disables failover; 0 keeps end-user runs off third parties.
LLM_FAILOVER=
LLM_FAILOVER_ENABLED=1
LLM_FAILOVER_USER_RUNS=1
LLM_ROUTE_BUDGET_S=120

# ---- Daily Investment Committee (all optional; see docs/DEPLOY_GCP.md 6d) ----
# Symbols reviewed per day: the engine's BUY/SELL/changed signals up to MAX, topped up to MIN
# with the biggest movers. Each run is ~7 model calls, so MAX*7 is the worst-case daily cost.
COMMITTEE_MIN_SYMBOLS=2
COMMITTEE_MAX_SYMBOLS=5
COMMITTEE_DAILY_BUDGET_S=1500
COMMITTEE_QUORUM=6
COMMITTEE_MAX_DATA_AGE_DAYS=5

# ---- Free public data (SEC filings, Treasury, BLS) ----
# The SEC requires a User-Agent that names a contact. Use YOUR project name and a monitored email:
# SEC_USER_AGENT=GlassBox research contact@yourdomain.com

# Daily digest email (Gmail app password: https://myaccount.google.com/apppasswords)
DIGEST_SMTP_USER=
DIGEST_SMTP_APP_PASSWORD=
DIGEST_TO_EMAIL=
# Optional WhatsApp copy of the admin digest via CallMeBot (free; messages only the number that registered the key).
# Get the key: https://www.callmebot.com/blog/free-api-whatsapp-messages/  Phone in international format, e.g. +15551234567
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
